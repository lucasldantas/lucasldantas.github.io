---
import { copy, type Locale } from '@/data/portfolio';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <div>
      <a class="brand footer-brand" href={locale === 'pt' ? '/' : '/en/'}>
        <span class="brand-mark" aria-hidden="true"><span>LD</span></span>
        <span class="brand-text">Lucas <strong>Dantas</strong></span>
      </a>
      <p>{t.footer}</p>
    </div>
    <div class="footer-links">
      <a href="mailto:lucasldantas@yahoo.com">Email</a>
      <a href="https://github.com/lucasldantas" target="_blank" rel="noreferrer">GitHub</a>
      <a href="https://www.linkedin.com/in/lucaslopesdantas" target="_blank" rel="noreferrer">LinkedIn</a>
    </div>
    <p class="footer-meta">© 2026 Lucas Lopes Dantas<br />Natal · RN · Brasil</p>
  </div>
</footer>
