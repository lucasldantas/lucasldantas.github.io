---
import BrandLogo from '@/components/BrandLogo.astro';
import { engineeringCaseHref, type EngineeringCase } from '@/data/engineering-cases';
import type { Locale } from '@/data/portfolio';

const { item, locale } = Astro.props as { item: EngineeringCase; locale: Locale };
const label = locale === 'pt' ? 'Explorar case' : 'Explore case';
---

<article class="engineering-case-card" data-reveal>
  <div class="engineering-case-visual" aria-hidden="true">
    <div class="case-logo-panel"><BrandLogo brand="glpi" name="GLPI" size="large" /></div>
    <span class="system-line system-line-a"></span>
    <span class="system-line system-line-b"></span>
    <span class="system-node system-node-a"></span>
    <span class="system-node system-node-b"></span>
    <span class="system-caption">ITSM.PLATFORM / CASE_{item.number}</span>
  </div>
  <div class="engineering-case-copy">
    <div class="case-card-meta"><span>{item.type}</span><span>{item.organization}</span></div>
    <h3>{item.title}</h3>
    <p>{item.summary}</p>
    <div class="tag-list">{item.technologies.slice(0, 5).map((technology) => <span>{technology}</span>)}</div>
    <a class="text-link" href={engineeringCaseHref(locale, item.slug)} aria-label={`${label}: ${item.title}`}>{label}<span aria-hidden="true"> →</span></a>
  </div>
</article>
