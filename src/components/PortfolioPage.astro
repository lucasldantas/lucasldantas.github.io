---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import EngineeringCaseCard from '@/components/EngineeringCaseCard.astro';
import BrandLogo from '@/components/BrandLogo.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { copy, projects, type Locale } from '@/data/portfolio';
import { engineeringCases } from '@/data/engineering-cases';
import { technologyCategories } from '@/data/technologies';

const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
const localizedProjects = projects[locale];
const publicProjects = localizedProjects.filter((project) => Boolean(project.repo));
const anonymizedProjects = localizedProjects.filter((project) => !project.repo);
const localizedCases = engineeringCases[locale];
const localizedTechnologies = technologyCategories[locale];
const ids = locale === 'pt'
  ? { cases: 'cases', projects: 'projetos', expertise: 'especialidades', timeline: 'trajetoria', contact: 'contato' }
  : { cases: 'cases', projects: 'work', expertise: 'expertise', timeline: 'experience', contact: 'contact' };
const sectionCopy = locale === 'pt' ? {
  casesEyebrow: 'Cases de Engenharia',
  casesTitle: 'Experiência aplicada em ambientes corporativos reais.',
  casesIntro: 'Soluções implementadas e sustentadas com foco em operação, administração de plataformas e evolução contínua.',
  studyEyebrow: 'Estudo de caso anonimizado',
  studyTitle: 'Experiência técnica preservada, contexto sensível protegido.',
  studyIntro: 'Este conteúdo descreve decisões e abordagens sem expor organização, dados, configurações ou indicadores internos.',
  techIntro: 'Produtos, plataformas e linguagens apresentados pelo papel que exercem no trabalho — sem rankings subjetivos ou níveis artificiais.',
  logoNote: 'Marcas identificam tecnologias utilizadas e não representam certificação, parceria ou endosso dos fabricantes.'
} : {
  casesEyebrow: 'Engineering Cases',
  casesTitle: 'Applied experience in real corporate environments.',
  casesIntro: 'Solutions implemented and sustained with a focus on operations, platform administration, and continuous evolution.',
  studyEyebrow: 'Anonymized case study',
  studyTitle: 'Technical experience preserved, sensitive context protected.',
  studyIntro: 'This content describes decisions and approaches without exposing organizations, data, configurations, or internal indicators.',
  techIntro: 'Products, platforms, and languages presented by the role they play in the work — without subjective rankings or artificial proficiency levels.',
  logoNote: 'Brand marks identify technologies used and do not represent certification, partnership, or vendor endorsement.'
};
---

<BaseLayout title={t.metaTitle} description={t.metaDescription} locale={locale}>
  <Header locale={locale} />

  <main id="conteudo">
    <section class="hero shell">
      <div class="hero-copy" data-reveal>
        <p class="eyebrow"><span></span>{t.role}</p>
        <h1>{t.heroTitle}</h1>
        <p class="hero-lead">{t.heroLead}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={`#${ids.cases}`}>{t.primaryCta}<span aria-hidden="true">↓</span></a>
          <a class="button button-ghost" href={`#${ids.contact}`}>{t.secondaryCta}<span aria-hidden="true">↗</span></a>
        </div>
        <p class="availability"><span class="pulse"></span>{t.availability}</p>
      </div>

      <div class="hero-visual" data-reveal>
        <div class="portrait-frame">
          <div class="portrait-coordinate coordinate-top">05°47′ S · 35°12′ W</div>
          <img src="/assets/lucas-lopes-dantas.png" alt={locale === 'pt' ? 'Retrato de Lucas Lopes Dantas' : 'Portrait of Lucas Lopes Dantas'} width="1254" height="1254" fetchpriority="high" />
          <div class="portrait-overlay"></div>
          <div class="portrait-corner corner-a"></div>
          <div class="portrait-corner corner-b"></div>
          <div class="portrait-label">
            <span>PROFILE_NODE</span>
            <strong>LUCAS.LD</strong>
          </div>
        </div>
        <div class="orbit-card card-a" aria-hidden="true"><span></span> API.CONNECTED</div>
        <div class="orbit-card card-b" aria-hidden="true"><span></span> SYS.OPERATIONAL</div>
      </div>

      <div class="proof-grid" data-reveal>
        {t.proof.map(([value, label]) => (
          <div class="proof-item">
            <strong>{value}</strong>
            <span>{label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="statement-section section-rule">
      <div class="shell statement-grid">
        <div data-reveal>
          <p class="section-index">/00</p>
          <p class="eyebrow"><span></span>{t.statementEyebrow}</p>
        </div>
        <div data-reveal>
          <h2 class="statement-title">{t.statement}</h2>
          <p class="large-body">{t.statementBody}</p>
        </div>
      </div>
    </section>

    <section class="engineering-cases-section section-rule" id={ids.cases}>
      <div class="shell">
        <div class="section-heading" data-reveal>
          <div>
            <p class="section-index">/01</p>
            <p class="eyebrow"><span></span>{sectionCopy.casesEyebrow}</p>
          </div>
          <div>
            <h2>{sectionCopy.casesTitle}</h2>
            <p>{sectionCopy.casesIntro}</p>
          </div>
        </div>
        <div class="engineering-cases-list">
          {localizedCases.map((item) => <EngineeringCaseCard item={item} locale={locale} />)}
        </div>
      </div>
    </section>

    <section class="projects-section section-rule" id={ids.projects}>
      <div class="shell">
        <div class="section-heading" data-reveal>
          <div>
            <p class="section-index">/02</p>
            <p class="eyebrow"><span></span>{t.projectsEyebrow}</p>
          </div>
          <div>
            <h2>{t.projectsTitle}</h2>
            <p>{t.projectsIntro}</p>
          </div>
        </div>
        <div class="projects-grid">
          {publicProjects.map((project) => <ProjectCard project={project} locale={locale} label={t.viewCase} />)}
        </div>
        <div class="secondary-project" data-reveal>
          <div>
            <span class="mini-index">/EXTRA</span>
            <h3>Slack Messenger</h3>
            <p>{locale === 'pt' ? 'Mensagens personalizadas em massa via Slack API, com tags dinâmicas, prévia e status por destinatário.' : 'Personalized bulk messages through the Slack API, with dynamic tags, preview, and per-recipient status.'}</p>
          </div>
          <a class="button button-ghost" href="https://github.com/lucasldantas/slack-messenger" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </div>

        <div class="work-subsection" data-reveal>
          <div class="work-subsection-heading">
            <p class="eyebrow"><span></span>{sectionCopy.studyEyebrow}</p>
            <h3>{sectionCopy.studyTitle}</h3>
            <p>{sectionCopy.studyIntro}</p>
          </div>
          <div class="anonymized-study-grid">
            {anonymizedProjects.map((project) => <ProjectCard project={project} locale={locale} label={locale === 'pt' ? 'Explorar estudo' : 'Explore study'} />)}
          </div>
        </div>
      </div>
    </section>

    <section class="expertise-section section-rule" id={ids.expertise}>
      <div class="shell">
        <div class="section-heading" data-reveal>
          <div>
            <p class="section-index">/03</p>
            <p class="eyebrow"><span></span>{t.expertiseEyebrow}</p>
          </div>
          <div><h2>{t.expertiseTitle}</h2><p>{sectionCopy.techIntro}</p></div>
        </div>
        <div class="technology-categories">
          {localizedTechnologies.map((category) => (
            <section class="technology-category" data-reveal>
              <header>
                <span>{category.code}</span>
                <div><h3>{category.title}</h3><p>{category.description}</p></div>
              </header>
              <div class="technology-grid">
                {category.items.map((item) => (
                  <article class="technology-card">
                    <BrandLogo brand={item.brand} name={item.name} />
                    <div><h4>{item.name}</h4><p>{item.description}</p></div>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
        <p class="brand-disclaimer">{sectionCopy.logoNote}</p>
      </div>
    </section>

    <section class="method-section section-rule">
      <div class="shell">
        <div class="section-heading" data-reveal>
          <div>
            <p class="section-index">/04</p>
            <p class="eyebrow"><span></span>{t.methodEyebrow}</p>
          </div>
          <div><h2>{t.methodTitle}</h2></div>
        </div>
        <div class="method-flow">
          {t.methodSteps.map(([title, text], index) => (
            <article class="method-step" data-reveal>
              <span class="method-number">0{index + 1}</span>
              <div class="method-node" aria-hidden="true"></div>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="timeline-section section-rule" id={ids.timeline}>
      <div class="shell">
        <div class="section-heading" data-reveal>
          <div>
            <p class="section-index">/05</p>
            <p class="eyebrow"><span></span>{t.timelineEyebrow}</p>
          </div>
          <div>
            <h2>{t.timelineTitle}</h2>
            <p>{t.timelineIntro}</p>
          </div>
        </div>
        <div class="timeline-layout">
          <div class="timeline" data-reveal>
            {t.timeline.map((item, index) => (
              <article class:list={['timeline-item', { current: index === 0 }]}>
                <div class="timeline-dot" aria-hidden="true"></div>
                <time>{item.period}</time>
                <div><h3>{item.role}</h3><p>{item.company}</p></div>
              </article>
            ))}
          </div>
          <aside class="education-panel" data-reveal>
            <div class="panel-header"><span>LEARNING.LOG</span><span>05 ITEMS</span></div>
            <h3>{t.educationTitle}</h3>
            <div class="education-list">
              {t.education.map(([course, school]) => (
                <div><strong>{course}</strong><span>{school}</span></div>
              ))}
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="contact-section section-rule" id={ids.contact}>
      <div class="shell contact-grid">
        <div data-reveal>
          <p class="section-index">/06</p>
          <p class="eyebrow"><span></span>{t.contactEyebrow}</p>
        </div>
        <div data-reveal>
          <h2>{t.contactTitle}</h2>
          <p>{t.contactText}</p>
          <a class="email-link" href="mailto:lucasldantas@yahoo.com">
            <span>{t.emailLabel}</span>
            <strong>lucasldantas@yahoo.com</strong>
            <span aria-hidden="true">↗</span>
          </a>
          <div class="contact-links">
            <a href="https://github.com/lucasldantas" target="_blank" rel="noreferrer">GitHub ↗</a>
            <a href="https://www.linkedin.com/in/lucaslopesdantas" target="_blank" rel="noreferrer">LinkedIn ↗</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</BaseLayout>
